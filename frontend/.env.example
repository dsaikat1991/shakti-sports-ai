# Environment variables for the frontend (Vite). Copy to .env.local and
# fill in for your environment - .env.local itself is gitignored, and
# only VITE_-prefixed variables are exposed to client-side code by Vite.

# Supabase project URL and publishable (anon) key - see lib/supabase.ts.
# Safe to expose client-side; access is enforced by Supabase RLS policies,
# not by keeping this key secret.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# Base URL of the FastAPI backend (backend/app/main.py) - used only for
# the two /api/analyze/video* endpoints; everything else talks directly
# to Supabase. Must match a CORS_ALLOWED_ORIGINS entry configured on the
# backend for this frontend's own origin (see backend/.env.example).
VITE_API_BASE_URL=http://localhost:8000
