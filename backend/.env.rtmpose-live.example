RTMPOSE_DEVICE=cuda:0
RTMPOSE_SCHEMA=halpe26
RTMPOSE_MIN_CONFIDENCE=0.35
RTMPOSE_MAX_PEOPLE=4
# RTMPOSE_DET_MODEL=rtmdet_m_640-8xb32_coco-person

# Structured logging level for this worker process (added in the
# Milestone C low-risk cleanup - previously no logging existed at all
# in rtmpose_worker/, so a crash left no server-side trace). One of the
# standard Python logging level names (DEBUG, INFO, WARNING, ERROR).
RTMPOSE_WORKER_LOG_LEVEL=INFO
