# Environment variables for the main backend API (app/main.py, app/api/routes.py).
# Copy to .env and fill in for your environment - .env itself is gitignored.
# For the separate RTMPose worker service's own variables, see
# .env.rtmpose-live.example instead.

# Comma-separated list of exact origins allowed to make credentialed
# requests to this API (CORS). Never set this to "*" - the API requires
# allow_credentials=True for Supabase-authenticated requests, and a
# wildcard origin combined with credentials would let any site make
# authenticated requests against it (main.py enforces this at startup).
# Defaults to http://localhost:5173 (the frontend's Vite dev port) if unset.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Base URL the main backend uses to reach the separate RTMPose worker
# service (rtmpose_worker/, a different process - see docs/ENGINEERING_HANDOFF.md §3).
# Defaults to http://127.0.0.1:8011 if unset.
RTMPOSE_WORKER_URL=http://127.0.0.1:8011

# Exact Supabase Storage host allowed for the /api/analyze/video-url
# endpoint's server-side download (SSRF allowlist - see routes.py's
# _validate_signed_video_url). Not a secret (a hostname alone grants no
# access), but this template intentionally shows a placeholder rather
# than a specific project's real value - copy the host from your own
# Supabase project's URL (Project Settings -> API).
SUPABASE_STORAGE_HOST=your-project-ref.supabase.co
